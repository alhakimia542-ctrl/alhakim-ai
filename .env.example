# Alhakim AI — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to version control.
# ─────────────────────────────────────────────────────────

# Your OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Google Custom Search API key — get one at https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Google Custom Search Engine ID (cx) — create one at https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
